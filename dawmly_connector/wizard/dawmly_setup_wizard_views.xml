<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dawmly_setup_wizard_view_form" model="ir.ui.view">
        <field name="name">dawmly.setup.wizard.form</field>
        <field name="model">dawmly.setup.wizard</field>
        <field name="arch" type="xml">
            <form string="Dawmly — Attendance &amp; Payroll Setup">
                <field name="state" invisible="1"/>
                <field name="existing_key_warning" invisible="1"/>

                <div class="alert alert-info" role="status" invisible="state != 'intro'">
                    <p class="mb-2">
                        <strong>Connect Odoo Accounting to Dawmly</strong>
                    </p>
                    <p class="mb-2">
                        Dawmly manages attendance, shifts, leave, and payroll for teams in Egypt and MENA,
                        and posts approved payroll runs to Odoo as balanced draft journal entries (one-way,
                        once per run).
                    </p>
                    <p class="mb-0">
                        Connecting requires a <strong>Dawmly Growth</strong> plan or higher (company admins only),
                        and your Odoo server must be reachable from the internet over a public
                        <code>https://</code> URL.
                    </p>
                </div>

                <div class="alert alert-warning" role="alert" invisible="state != 'intro' or not existing_key_warning">
                    <strong>Existing API key(s) detected on <code>dawmly-connector</code>:</strong>
                    running setup again will revoke all existing API keys on that user, reset its permissions to
                    Billing only, and generate a new key.
                </div>

                <group invisible="state != 'intro'" string="What Setup Will Configure">
                    <div colspan="2" class="text-muted">
                        <ul class="mb-0 ps-3">
                            <li>
                                Create or reuse dedicated internal user <code>dawmly-connector</code> with
                                Billing rights (read accounts and journals, create draft journal entries only).
                            </li>
                            <li>
                                Create or reuse a <strong>Dawmly</strong> general journal (code <code>DAWM</code>).
                            </li>
                            <li>
                                Generate a persistent API key for <code>dawmly-connector</code> and show it once.
                            </li>
                        </ul>
                    </div>
                </group>

                <div class="alert alert-success" role="status" invisible="state != 'ready'">
                    <p class="mb-1">
                        <strong>Credentials ready.</strong> Copy the four values below into
                        <strong>Integrations → Odoo</strong> in Dawmly.
                    </p>
                    <p class="mb-0">
                        <strong>Copy your API key now:</strong> Odoo does not store API keys in readable form
                        and will not show this key again after you close this screen.
                    </p>
                </div>

                <group invisible="state != 'ready'" string="Dawmly Connection Credentials">
                    <field name="odoo_url" widget="CopyClipboardChar"/>
                    <field name="database_name" widget="CopyClipboardChar" readonly="1"/>
                    <field name="username" widget="CopyClipboardChar" readonly="1"/>
                    <field name="api_key" widget="CopyClipboardChar" readonly="1"/>
                </group>

                <group invisible="state != 'ready'" string="Setup Summary">
                    <field name="user_status" readonly="1"/>
                    <field name="journal_status" readonly="1"/>
                </group>

                <div class="text-muted mt-2">
                    Need help? Contact <a href="mailto:hello@dawmly.com">hello@dawmly.com</a> or read the
                    <a href="https://dawmly.com/features/odoo-integration/" target="_blank">Odoo integration guide</a>.
                </div>

                <footer>
                    <button
                        name="action_setup"
                        string="Set Up Dawmly Connection"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'intro'"
                    />
                    <button
                        name="action_open_dawmly"
                        string="Open Dawmly Integrations"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'ready'"
                    />
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dawmly_setup_wizard" model="ir.actions.act_window">
        <field name="name">Dawmly Setup</field>
        <field name="res_model">dawmly.setup.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_dawmly_setup_wizard"
        name="Dawmly Setup"
        parent="account.menu_finance_configuration"
        action="action_dawmly_setup_wizard"
        groups="base.group_system"
        sequence="95"
    />
</odoo>
